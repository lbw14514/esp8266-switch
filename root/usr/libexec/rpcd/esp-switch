#!/bin/sh
. /usr/share/libubox/jshn.sh

CFG=esp-switch
CURL=/usr/bin/curl
[ -x "$CURL" ] || CURL=curl

jf() {
	echo "$1" | jsonfilter -e "$2" 2>/dev/null
}

dev_secs() {
	uci -q show "$CFG" 2>/dev/null | sed -n "s/^$CFG\.dev_\([^.]*\)=device$/\1/p"
}

ignore_secs() {
	uci -q show "$CFG" 2>/dev/null | sed -n "s/^$CFG\.ignore_\([^.]*\)=.*$/\1/p"
}

uci_name() {
	uci -q get "$CFG.dev_$1.name"
}

uci_addr() {
	uci -q get "$CFG.dev_$1.address"
}

is_paired() {
	uci -q show "$CFG.dev_$1" >/dev/null 2>&1
}

is_ignored() {
	[ -n "$(uci -q get "$CFG.ignore_$1")" ]
}

unique_name() {
	local id="$1" base="$2" name n sec clash
	[ -n "$base" ] || base="ESP-$id"
	name="$base"
	n=1
	while :; do
		clash=0
		for sec in $(dev_secs); do
			[ "$sec" = "$id" ] && continue
			[ "$(uci_name "$sec")" = "$name" ] && clash=1
		done
		[ "$clash" = "0" ] && break
		n=$((n + 1))
		name="$base-$n"
	done
	echo "$name"
}

pair_device() {
	local id="$1" addr="$2" name="$3"
	[ -z "$id" ] && return 1
	local sec="dev_$id" changed=0
	is_paired "$id" || {
		uci -q set "$CFG.$sec=device"
		changed=1
	}
	if [ -n "$name" ] && [ "$(uci_name "$id")" != "$name" ]; then
		uci -q set "$CFG.$sec.name=$name"
		changed=1
	fi
	if [ -n "$addr" ] && [ "$(uci_addr "$id")" != "$addr" ]; then
		uci -q set "$CFG.$sec.address=$addr"
		changed=1
	fi
	[ "$changed" = "1" ] && uci -q commit "$CFG"
	return 0
}

discover() {
	local out="$1"
	: >"$out"
	command -v avahi-browse >/dev/null 2>&1 || return 0
	local raw pick
	raw="$(mktemp)"
	pick="$(mktemp)"
	avahi-browse -rtp -t _esp-switch._tcp 2>/dev/null | grep '^=' >"$raw"
	grep '^=' "$raw" 2>/dev/null | awk -F';' '$2 == "br-lan" && $3 == "IPv4"' >"$pick"
	[ -s "$pick" ] || grep '^=' "$raw" 2>/dev/null | awk -F';' '$3 == "IPv4" && $2 != "lo" && $2 != "docker0"' >"$pick"
	rm -f "$raw"
	local mark iface proto svcname stype domain host addr port txt id hname
	local seen=""
	while IFS=';' read -r mark iface proto svcname stype domain host addr port txt; do
		[ "$mark" = "=" ] || continue
		id="$(echo "$txt" | sed -n 's/.*"id=\([^"]*\)".*/\1/p')"
		[ -z "$id" ] && id="$(echo "$host" | cut -d. -f1)"
		[ -z "$id" ] && continue
		case " $seen " in *" $id "*) continue ;; esac
		seen="$seen $id"
		hname="$(echo "$host" | cut -d. -f1)"
		echo "$id|$hname|$addr" >>"$out"
	done <"$pick"
	rm -f "$pick"
}

item_json() {
	local id="$1" host="$2" addr="$3" infofile="$4"
	local info=""
	if [ -n "$infofile" ] && [ -f "$infofile" ]; then
		info="$(cat "$infofile")"
	fi
	if [ -n "$info" ] && [ -z "$(jf "$info" '@.id')" ]; then
		info=""
	fi
	local name="" ip="" online=0 pins=""
	local ch1="" ch2="" ch3="" a1="" b1="" a2="" b2="" a3="" b3=""
	if [ -n "$info" ]; then
		online=1
		name="$(jf "$info" '@.name')"
		ip="$(jf "$info" '@.ip')"
		ch1="$(jf "$info" '@.channels[0].name')"
		ch2="$(jf "$info" '@.channels[1].name')"
		ch3="$(jf "$info" '@.channels[2].name')"
		a1="$(jf "$info" '@.channels[0].pinA')"
		b1="$(jf "$info" '@.channels[0].pinB')"
		a2="$(jf "$info" '@.channels[1].pinA')"
		b2="$(jf "$info" '@.channels[1].pinB')"
		a3="$(jf "$info" '@.channels[2].pinA')"
		b3="$(jf "$info" '@.channels[2].pinB')"
		pins="$(jf "$info" '@.pins' | tr -d '[] ')"
		if [ -n "$ip" ]; then
			local base_host="${addr%%:*}" base_port=""
			case "$addr" in *:*) base_port=":${addr##*:}" ;; esac
			[ "$ip" != "$base_host" ] && addr="$ip$base_port"
		fi
	fi
	if is_paired "$id"; then
		[ -n "$online" ] && [ "$online" = "1" ] && pair_device "$id" "$addr" ""
	else
		name="$(unique_name "$id" "$name")"
	fi
	local custom ucn
	custom="$(uci_name "$id")"
	[ -n "$custom" ] && name="$custom"
	[ -z "$name" ] && name="$host"
	[ -z "$name" ] && name="$id"
	[ -z "$addr" ] && addr="$(uci_addr "$id")"
	ucn="$(uci -q get "$CFG.dev_$id.ch1")"; [ -n "$ucn" ] && ch1="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.ch2")"; [ -n "$ucn" ] && ch2="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.ch3")"; [ -n "$ucn" ] && ch3="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.a1")"; [ -n "$ucn" ] && a1="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.b1")"; [ -n "$ucn" ] && b1="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.a2")"; [ -n "$ucn" ] && a2="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.b2")"; [ -n "$ucn" ] && b2="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.a3")"; [ -n "$ucn" ] && a3="$ucn"
	ucn="$(uci -q get "$CFG.dev_$id.b3")"; [ -n "$ucn" ] && b3="$ucn"
	json_init
	json_add_string id "$id"
	json_add_string name "$name"
	json_add_string address "$addr"
	json_add_boolean online "$online"
	json_add_string ch1 "$ch1"
	json_add_string ch2 "$ch2"
	json_add_string ch3 "$ch3"
	json_add_string a1 "$a1"
	json_add_string b1 "$b1"
	json_add_string a2 "$a2"
	json_add_string b2 "$b2"
	json_add_string a3 "$a3"
	json_add_string b3 "$b3"
	json_add_string pinA "$a1"
	json_add_string pinB "$b1"
	json_add_string pins "$pins"
	json_dump | tr -d '\n'
}

devices() {
	local scan probe known
	json_get_var scan scan
	json_get_var probe probe
	[ -z "$probe" ] && probe=1
	known="$(dev_secs | wc -l)"
	local do_scan=0
	[ "$scan" != "0" ] && do_scan=1
	[ "$known" = "0" ] && do_scan=1

	local list
	list="$(mktemp)"
	if [ "$do_scan" = "1" ]; then
		discover "$list"
	fi
	local sec id
	for sec in $(dev_secs); do
		id="${sec#dev_}"
		grep -q "^$id|" "$list" || echo "$id||$(uci_addr "$id")" >>"$list"
	done

	local dir
	dir="$(mktemp -d)"
	local host addr
	if [ "$probe" = "1" ]; then
		while IFS='|' read -r id host addr; do
			if [ -n "$addr" ]; then
				"$CURL" -s -m 2 "http://$addr/api/info" >"$dir/$id" 2>/dev/null
			fi
		done <"$list"
	fi

	local out_dev="" out_pend="" json
	while IFS='|' read -r id host addr; do
		[ -z "$id" ] && continue
		is_ignored "$id" && continue
		json="$(item_json "$id" "$host" "$addr" "$dir/$id")"
		if is_paired "$id"; then
			if [ -z "$out_dev" ]; then out_dev="$json"; else out_dev="$out_dev,$json"; fi
		else
			if [ -z "$out_pend" ]; then out_pend="$json"; else out_pend="$out_pend,$json"; fi
		fi
	done <"$list"
	rm -rf "$list" "$dir"
	printf '{"devices":[%s],"pending":[%s]}\n' "$out_dev" "$out_pend"
}

approve() {
	local id name address
	json_get_var id id
	json_get_var name name
	json_get_var address address
	if [ -z "$id" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error "missing id"
		json_dump
		return
	fi
	name="$(unique_name "$id" "$name")"
	pair_device "$id" "$address" "$name"
	if [ -n "$address" ]; then
		"$CURL" -s -m 3 -X POST --data-urlencode "name=$name" "http://$address/api/config" >/dev/null 2>&1
	fi
	json_init
	json_add_boolean ok 1
	json_add_string name "$name"
	json_dump
}

reject() {
	local id sec
	json_get_var id id
	if [ "$id" = "*" ]; then
		for sec in $(ignore_secs); do
			uci -q delete "$CFG.ignore_$sec"
		done
		uci -q commit "$CFG"
	elif [ -n "$id" ]; then
		uci -q delete "$CFG.dev_$id"
		uci -q set "$CFG.ignore_$id=ignore"
		uci -q commit "$CFG"
	fi
	json_init
	json_add_boolean ok 1
	json_dump
}

restore() {
	local sec
	for sec in $(ignore_secs); do
		uci -q delete "$CFG.ignore_$sec"
	done
	uci -q commit "$CFG"
	json_init
	json_add_boolean ok 1
	json_dump
}

pulse() {
	local address ch ms
	json_get_var address address
	json_get_var ch ch
	json_get_var ms ms
	[ -z "$ms" ] && ms="$(uci -q get $CFG.settings.pulse_ms)"
	[ -z "$ms" ] && ms=500
	json_init
	if [ -z "$address" ] || [ -z "$ch" ]; then
		json_add_boolean ok 0
		json_add_string error "missing address or channel"
		json_dump
		return
	fi
	local res
	res="$("$CURL" -s -m 3 "http://$address/api/pulse?ch=$ch&ms=$ms" 2>/dev/null)"
	if [ -n "$res" ]; then
		json_add_boolean ok 1
		json_add_string raw "$res"
	else
		json_add_boolean ok 0
		json_add_string error "device unreachable"
	fi
	json_dump
}

save() {
	local id name address
	json_get_var id id
	json_get_var name name
	json_get_var address address
	if [ -z "$id" ]; then
		json_init
		json_add_boolean ok 0
		json_add_string error "missing id"
		json_dump
		return
	fi
	name="$(unique_name "$id" "$name")"
	local sec="dev_$id"
	is_paired "$id" || uci -q set "$CFG.$sec=device"
	uci -q delete "$CFG.ignore_$id" 2>/dev/null
	[ -n "$name" ] && uci -q set "$CFG.$sec.name=$name"
	[ -n "$address" ] && uci -q set "$CFG.$sec.address=$address"
	local i key val
	for i in 1 2 3 4; do
		for key in "ch$i" "a$i" "b$i"; do
			val=""
			json_get_var val "$key"
			[ -n "$val" ] && uci -q set "$CFG.$sec.$key=$val"
		done
	done
	uci -q commit "$CFG"
	local pushed=0
	if [ -n "$address" ]; then
		local ok=1
		if [ -n "$name" ]; then
			"$CURL" -s -m 3 -X POST --data-urlencode "name=$name" "http://$address/api/config" >/dev/null 2>&1 || ok=0
		fi
		for i in 1 2 3 4; do
			for key in "ch$i" "a$i" "b$i"; do
				val="$(uci -q get "$CFG.$sec.$key")"
				if [ -n "$val" ]; then
					"$CURL" -s -m 3 -X POST --data-urlencode "$key=$val" "http://$address/api/config" >/dev/null 2>&1 || ok=0
				fi
			done
		done
		[ "$ok" = "1" ] && pushed=1
	fi
	json_init
	json_add_boolean ok 1
	json_add_boolean pushed "$pushed"
	json_add_string name "$name"
	json_dump
}

settings() {
	local pulse_ms discover_timeout
	json_get_var pulse_ms pulse_ms
	json_get_var discover_timeout discover_timeout
	[ -n "$pulse_ms" ] && uci -q set "$CFG.settings.pulse_ms=$pulse_ms"
	[ -n "$discover_timeout" ] && uci -q set "$CFG.settings.discover_timeout=$discover_timeout"
	uci -q commit "$CFG"
	json_init
	json_add_boolean ok 1
	json_add_string pulse_ms "$(uci -q get $CFG.settings.pulse_ms)"
	json_add_string discover_timeout "$(uci -q get $CFG.settings.discover_timeout)"
	json_dump
}

case "$1" in
list)
	json_init
	json_add_object devices
	json_add_string scan 1
	json_add_string probe 1
	json_close_object
	json_add_object approve
	json_add_string id ""
	json_add_string name ""
	json_add_string address ""
	json_close_object
	json_add_object remove
	json_add_string id ""
	json_close_object
	json_add_object reject
	json_add_string id ""
	json_close_object
	json_add_object restore
	json_close_object
	json_add_object pulse
	json_add_string ch 1
	json_add_string address ""
	json_close_object
	json_add_object save
	json_add_string id ""
	json_add_string name ""
	json_add_string address ""
	json_add_string ch1 ""
	json_add_string ch2 ""
	json_add_string ch3 ""
	json_add_string a1 ""
	json_add_string b1 ""
	json_add_string a2 ""
	json_add_string b2 ""
	json_add_string a3 ""
	json_add_string b3 ""
	json_close_object
	json_add_object settings
	json_add_string pulse_ms ""
	json_add_string discover_timeout ""
	json_close_object
	json_dump
	;;
call)
	read -r input
	json_load "$input"
	case "$2" in
	devices) devices ;;
	approve) approve ;;
	remove|reject) reject ;;
	restore) restore ;;
	pulse) pulse ;;
	save) save ;;
	settings) settings ;;
	*)
		json_init
		json_add_boolean ok 0
		json_add_string error "unknown method"
		json_dump
		;;
	esac
	;;
*)
	echo "{}"
	;;
esac
